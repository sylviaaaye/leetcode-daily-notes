class Solution {
private:

        void traversal(TreeNode* node, vector<int>& path, vector<string>& sPath) {
        path.push_back(node->val);

        if(node->left == NULL && node->right == NULL){
        string s;
        for(int i = 0;i<path.size()-1;i++){
            s += to_string(path[i]);
            s += "->";
        }
        s += to_string(path[path.size() - 1]);
        sPath.push_back(s);
        return;
        }

        if(node->left){
        traversal(node->left, path, sPath);
        path.pop_back();}

        if(node->right){
        traversal(node->right, path, sPath);
        path.pop_back();}


    }
public:
    vector<string> binaryTreePaths(TreeNode* root) {
        vector<int> path;
    vector<string> sPath;
        if(root == NULL) return sPath;
        traversal(root, path, sPath);
        return sPath;
    }
};
```

