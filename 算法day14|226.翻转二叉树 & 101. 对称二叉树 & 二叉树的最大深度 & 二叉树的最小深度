class Solution {
public:
    TreeNode* getInvert(TreeNode* root){
        if(root == NULL) return NULL;
        swap(root->left, root->right);
        getInvert(root->left);
        getInvert(root->right);
        return root;


    }
    TreeNode* invertTree(TreeNode* root) {
        if(root == NULL) return NULL;
        return getInvert(root);
        
    }
};
```

- 复盘与提升：即使一边是空也可以swap

